{
  "expo": {
    "name": "Vámonos de pesca",
    "slug": "pesca-castellon",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c2c20"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tuusuario.pescacastellon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para avisarte si te acercas o estás dentro de un coto o zona vedada, y para mostrarte las zonas libres más cercanas.",
        "NSFaceIDUsageDescription": "Usamos Face ID para desbloquear la app de forma rápida y segura."
      }
    },
    "android": {
      "package": "com.tuusuario.pescacastellon",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#0c2c20"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/favicon.png",
      "name": "Vámonos de pesca",
      "shortName": "Vámonos",
      "themeColor": "#0c2c20",
      "backgroundColor": "#eef2ee",
      "lang": "es"
    },
    "experiments": {
      "baseUrl": "/pesca-castellon"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para avisarte de cotos/vedas cercanos y mostrarte zonas libres."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0c2c20",
          "icon": "./assets/brand/icon.png"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Para adjuntar una foto a tus capturas en el diario."
        }
      ]
    ]
  }
}
